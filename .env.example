# Lowwin Diaspora — Environment Configuration Template
# Never commit real secrets or production credentials to source control.

# Application Environment
NODE_ENV="development"
PORT=3000
APP_URL="https://example.com"
ALLOWED_ORIGINS="http://localhost:3000,https://example.com"

# Mandatory Server-Side Launch Gates (Fail-Closed Defaults)
PAID_ENTRIES_ENABLED=false
PRODUCTION_PAYMENTS_ENABLED=false
PROPERTY_AWARD_ENABLED=false
LEGAL_APPROVAL_STATUS="not_reviewed"
PAYMENT_PROVIDER_ENABLED=false

# Initial Superadmin Configuration (Securely configured on server)
INITIAL_SUPERADMIN_ID="usr_superadmin_bootstrap"
INITIAL_SUPERADMIN_EMAIL="admin@lowwin-diaspora.com"

# Firebase Client Configuration (Admin & User Authentication)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="lowwin-diaspora.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="lowwin-diaspora"
VITE_FIREBASE_STORAGE_BUCKET="lowwin-diaspora.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Firebase Server Admin SDK
FIREBASE_ADMIN_PROJECT_ID="lowwin-diaspora"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk@lowwin-diaspora.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Verified Payment Gateway (Stripe / International Cards)
# Fixed ticket entry: $49.00 USD (4900 integer cents)
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# PayPal Merchant Integration (Approved Business Account)
PAYPAL_CLIENT_ID="paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="paypal_sandbox_client_secret"
PAYPAL_MODE="sandbox"

# Property Document & Title File Storage (Private Bucket)
PROPERTY_DOCUMENTS_BUCKET="lowwin-diaspora-secure-evidence"

# Compliance & Legal Settings
ELIGIBILITY_MIN_AGE=21
APPROVED_LEGAL_COUNSEL_REFERENCE="ET-LAW-REV-PENDING"

